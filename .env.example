# ==============================================================================
# SentinelAI - Root Environment Configuration Template
# Copy this file to individual service directories as instructed
# ==============================================================================

# --- Database Settings (MySQL 8.x) ---
# REQUIRED: Connection URL for local MySQL instance
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=sentinelai_db
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here

# --- Spring Boot Backend Configuration ---
# REQUIRED: Secret key for signing and verifying JWT tokens (min 256 bits)
JWT_SECRET=your_jwt_secret_key_at_least_32_characters_long_super_secure!
# OPTIONAL: Token expiration time in milliseconds (default 24h: 86400000)
JWT_EXPIRATION_MS=86400000
# REQUIRED: URL for FastAPI AI service
AI_SERVICE_URL=http://localhost:8000
# REQUIRED: Shared internal secret between Spring Boot and FastAPI
INTERNAL_SERVICE_SECRET=your_shared_internal_service_secret_token_12345

# --- AI Engine & LLM Configuration (Python FastAPI) ---
# REQUIRED: Google Gemini API Key for LangGraph agent and DeepEval judge
GEMINI_API_KEY=your_gemini_api_key_here
# OPTIONAL: Default LLM Model Name
DEFAULT_LLM_MODEL=gemini-1.5-flash
# OPTIONAL: Fast API Server Port
FASTAPI_PORT=8000

# --- Frontend Configuration (React + Vite) ---
# REQUIRED: Base URL for Spring Boot backend API
VITE_API_BASE_URL=http://localhost:8080/api/v1
