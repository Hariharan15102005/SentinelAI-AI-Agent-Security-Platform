# ==============================================================================
# SentinelAI - AI Microservice (FastAPI) Environment Configuration
# ==============================================================================

# REQUIRED: Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# REQUIRED: Shared internal token (must match Spring Boot configuration)
INTERNAL_SERVICE_SECRET=your_shared_internal_service_secret_token_12345

# OPTIONAL: FastAPI Server Settings
PORT=8000
HOST=0.0.0.0
DEBUG=true

# OPTIONAL: Default Model Configuration
DEFAULT_LLM_MODEL=gemini-1.5-flash
DEEPEVAL_JUDGE_MODEL=gemini-1.5-flash
